# ─────────────────────────────────────────────────────────────────
# LLM configuration — provider-agnostic via OpenAI-compatible API
# ─────────────────────────────────────────────────────────────────
# Required
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.minimax.io/anthropic
LLM_MODEL=MiniMax-M3

# Optional tuning
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# ─────────────────────────────────────────────────────────────────
# Run config
# ─────────────────────────────────────────────────────────────────
# Roughly covers 4 LLM calls (PM + Architect + Engineer + QA) at
# 8K output tokens total. Increase if running on a heavier model or
# larger requirement.
MAX_BUDGET_USD=2.50
# Verbose per-message logging to stdout
VERBOSE=true