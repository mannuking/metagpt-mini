# ─────────────────────────────────────────────────────────────────
# LLM configuration — provider-agnostic via OpenAI-compatible API
# ─────────────────────────────────────────────────────────────────
# Required
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.minimax.io/anthropic
LLM_MODEL=MiniMax-M3

# MiniMax-M3 standard tier: $0.30/M input, $1.20/M output
# Anthropic Opus 4.5 reference: ~$15/M input, ~$75/M output  (50x more expensive)
# Adjust COST_INPUT_PER_1K / COST_OUTPUT_PER_1K in metagpt_mini/llm.py for other models.
LLM_CONTEXT_WINDOW=1048576
LLM_MAX_TOKENS=16384

# Optional tuning
LLM_TEMPERATURE=0.2

# ─────────────────────────────────────────────────────────────────
# Run config
# ─────────────────────────────────────────────────────────────────
# Roughly covers 4 LLM calls (PM + Architect + Engineer + QA) at
# 8K output tokens total. Increase if running on a heavier model or
# larger requirement.
MAX_BUDGET_USD=2.50
# Verbose per-message logging to stdout
VERBOSE=true