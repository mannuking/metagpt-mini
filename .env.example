# ─────────────────────────────────────────────────────────────────
# LLM configuration — provider-agnostic via OpenAI-compatible API
# ─────────────────────────────────────────────────────────────────
# Required
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.minimax.chat/v1
LLM_MODEL=MiniMax-M3

# Optional tuning
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# ─────────────────────────────────────────────────────────────────
# Run config
# ─────────────────────────────────────────────────────────────────
# How many dollars/credits to spend on a single run (rough guard)
MAX_BUDGET_USD=0.50
# Verbose per-message logging to stdout
VERBOSE=true